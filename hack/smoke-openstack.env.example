# Copy this file outside git-tracked paths or keep the copy uncommitted, then fill values.
# Run: SMOKE_ENV_FILE=/path/to/smoke-openstack.env bash hack/smoke-openstack-apply.sh

API_BASE=http://localhost:8080/api

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

OPENSTACK_CLOUD=demo
OPENSTACK_AUTH_URL=https://openstack.example:5000/v3
OPENSTACK_USERNAME=demo-user
OPENSTACK_PASSWORD=change-me
OPENSTACK_PROJECT_NAME=demo-project
# OPENSTACK_PROJECT_ID=
OPENSTACK_REGION_NAME=RegionOne
OPENSTACK_INTERFACE=public
OPENSTACK_IDENTITY_INTERFACE=public
OPENSTACK_USER_DOMAIN_NAME=Default
OPENSTACK_PROJECT_DOMAIN_NAME=Default
OPENSTACK_ENDPOINT_OVERRIDE_JSON='{}'

# Leave image/flavor empty for provider catalog auto-discovery, or set explicit names/ids.
# SMOKE_IMAGE=id:<image-id>
# SMOKE_FLAVOR=id:<flavor-id>
SMOKE_SECURITY_GROUPS=auto
# Set to auto to select the first provider keypair, none to omit it, or a specific keypair name.
SMOKE_SSH_KEY_NAME=none
SMOKE_INSTANCE_COUNT=1

SMOKE_DESTROY_AFTER_APPLY=true
SMOKE_DESTROY_ON_APPLY_FAILURE=true
SMOKE_VERIFY_WS=auto
# Set true to stop after provider auth/catalog validation without creating an environment.
SMOKE_PREFLIGHT_ONLY=false
