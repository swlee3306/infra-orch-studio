# Use this when the API database already has an OpenStack provider connection.
# Run: SMOKE_ENV_FILE=hack/smoke-openstack-existing-provider.env.example make smoke-openstack-existing-provider-config
# Then run: SMOKE_ENV_FILE=/path/to/filled.env make smoke-openstack-existing-provider

API_BASE=http://localhost:8080/api

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

OPENSTACK_CLOUD=demo
SMOKE_SKIP_PROVIDER_UPSERT=true

# Leave image/flavor empty for provider catalog auto-discovery, or set explicit names/ids.
# SMOKE_IMAGE=id:<image-id>
# SMOKE_FLAVOR=id:<flavor-id>
SMOKE_SECURITY_GROUPS=auto
SMOKE_SSH_KEY_NAME=none
SMOKE_INSTANCE_COUNT=1

SMOKE_DESTROY_AFTER_APPLY=true
SMOKE_DESTROY_ON_APPLY_FAILURE=true
SMOKE_VERIFY_WS=auto
SMOKE_PREFLIGHT_ONLY=false
